# Solo desarrollo aislado puede optar explícitamente por true.
# Producción y previews rechazan true; nunca existe fallback automático.
NEXT_PUBLIC_DEMO_MODE=false

# Required for every environment: public values safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this variable in browser code or commit it.
# Los adapters actuales no necesitan service role. Configurar solo si una
# futura operación privilegiada de servidor lo requiere y ha sido revisada.
# SUPABASE_SERVICE_ROLE_KEY=
