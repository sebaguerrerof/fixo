    "policies": [
      {
        "name": "Technicians and administrators view verification documents",
        "check": null,
        "roles": [
          "authenticated"
        ],
        "table": "objects",
        "using": "((bucket_id = 'technician-documents'::text) AND (((storage.foldername(name))[1] = (auth.uid())::text) OR is_admin()))",
        "schema": "storage",
        "command": "SELECT"
      },
      {
        "name": "Technicians upload their own documents",
        "check": "((bucket_id = 'technician-documents'::text) AND ((storage.foldername(name))[1] = (auth.uid())::text))",
        "roles": [
          "authenticated"
        ],
        "table": "objects",
        "using": null,
        "schema": "storage",
        "command": "INSERT"
      },
      {
        "name": "Categories are public",
        "check": null,
        "roles": [
          "public"
        ],
        "table": "categories",
        "using": "true",
        "schema": "public",
        "command": "SELECT"
      },
      {
        "name": "Technicians and administrators view their documents",
        "check": null,
        "roles": [
          "public"
        ],
        "table": "technician_documents",
        "using": "((technician_id = auth.uid()) OR is_admin())",
        "schema": "public",
        "command": "SELECT"
      },
      {
        "name": "Public profiles are visible for public technicians",
        "check": null,
        "roles": [
          "public"
        ],
        "table": "profiles",
        "using": "((id = auth.uid()) OR is_admin() OR (EXISTS ( SELECT 1\n   FROM technician_profiles\n  WHERE ((technician_profiles.user_id = profiles.id) AND (technician_profiles.status = ANY (ARRAY['verified'::technician_status, 'active'::technician_status]))))))",
        "schema": "public",
        "command": "SELECT"
      },
      {
        "name": "Public technicians are visible and private profiles remain scop",
        "check": null,
        "roles": [
          "public"
        ],
        "table": "technician_profiles",
        "using": "((status = ANY (ARRAY['verified'::technician_status, 'active'::technician_status])) OR (user_id = auth.uid()) OR is_admin())",
        "schema": "public",
        "command": "SELECT"
      },
      {
        "name": "Technician categories follow profile visibility",
        "check": null,
        "roles": [
          "public"
        ],
        "table": "technician_categories",
        "using": "((technician_id = auth.uid()) OR is_admin() OR (EXISTS ( SELECT 1\n   FROM technician_profiles\n  WHERE ((technician_profiles.user_id = technician_categories.technician_id) AND (technician_profiles.status = ANY (ARRAY['verified'::technician_status, 'active'::technician_status]))))))",
        "schema": "public",
        "command": "SELECT"
      },
      {
        "name": "Technician specialties follow profile visibility",
        "check": null,
        "roles": [
          "public"
        ],
        "table": "technician_specialties",
        "using": "((technician_id = auth.uid()) OR is_admin() OR (EXISTS ( SELECT 1\n   FROM technician_profiles\n  WHERE ((technician_profiles.user_id = technician_specialties.technician_id) AND (technician_profiles.status = ANY (ARRAY['verified'::technician_status, 'active'::technician_status]))))))",
        "schema": "public",
        "command": "SELECT"
      },
      {
        "name": "Technician metrics follow profile visibility",
        "check": null,
        "roles": [
          "public"
        ],
        "table": "technician_metrics",
        "using": "((technician_id = auth.uid()) OR is_admin() OR (EXISTS ( SELECT 1\n   FROM technician_profiles\n  WHERE ((technician_profiles.user_id = technician_metrics.technician_id) AND (technician_profiles.status = ANY (ARRAY['verified'::technician_status, 'active'::technician_status]))))))",
        "schema": "public",
        "command": "SELECT"
      },
      {
        "name": "Administrators read audit entries",
        "check": null,
        "roles": [
          "public"
        ],
        "table": "admin_audit_entries",
        "using": "is_admin()",
        "schema": "public",
        "command": "SELECT"
      },
      {
        "name": "Customers view their own service requests",
        "check": null,
        "roles": [
          "public"
        ],
        "table": "service_requests",
        "using": "((customer_id = auth.uid()) OR (assigned_technician_id = active_technician_id()) OR is_admin())",
        "schema": "public",
        "command": "SELECT"
      },
      {
        "name": "Customers create their own service requests",
        "check": "((customer_id = auth.uid()) AND (EXISTS ( SELECT 1\n   FROM profiles\n  WHERE ((profiles.id = auth.uid()) AND (profiles.role = 'customer'::app_role)))))",
        "roles": [
          "public"
        ],
        "table": "service_requests",
        "using": null,
        "schema": "public",
        "command": "INSERT"
