# Modo demo: usa repositorios mock (fixtures) sin necesitar Supabase.
# "true" fuerza demo mode, "false" fuerza modo producción real; si se omite,
# se activa automáticamente cuando faltan credenciales de Supabase abajo.
NEXT_PUBLIC_DEMO_MODE=true

# Required for every environment: public values safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Never expose this variable in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
