# Solo desarrollo aislado puede optar explícitamente por true.
# Producción y previews rechazan true; nunca existe fallback automático.
NEXT_PUBLIC_DEMO_MODE=false

# Required for every environment: public values safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: required by Auth rate limits, flow proofs and invitation delivery.
# Set through the environment secret manager, never NEXT_PUBLIC.
# SUPABASE_SERVICE_ROLE_KEY=
FIXO_APP_URL=http://127.0.0.1:3000
FIXO_INVITATIONS_ENABLED=false

# Dedicated inspection worker only, not browser variables or Vercel frontend defaults.
# FIXO_INSPECTION_PROJECT=
# FIXO_CLAMSCAN_PATH=
# FIXO_CLAMAV_DATABASE_DIR=
# FIXO_INSPECTION_LOAD_LOCAL=false

# Dedicated notification worker: Sprint 04 supports synthetic local capture only.
# FIXO_NOTIFICATION_ADAPTER=capture
# FIXO_NOTIFICATION_PROJECT=
# FIXO_NOTIFICATION_SYNTHETIC_RECIPIENTS=
# FIXO_NOTIFICATION_CAPTURE_DIR=
# FIXO_NOTIFICATION_LOAD_LOCAL=false
# Flow: disabled by default. Sandbox only (fixed API host); server-only secrets via secret manager, never NEXT_PUBLIC.
# FIXO_FLOW_MODE=disabled            # sólo selecciona el ENTORNO de Flow (disabled|sandbox); por sí solo no habilita cobros ni notificaciones
# FIXO_PAYMENTS_CREATION_ENABLED=false       # interruptor de NUEVOS cobros; sólo el literal "true" lo activa
# FIXO_PAYMENTS_NOTIFICATIONS_ENABLED=false  # interruptor de recepción/verificación de notificaciones; sólo "true". Mantener activo al revertir hasta resolver los pendientes
# FIXO_PAYMENTS_WORKER_SECRET=      # >= 32 caracteres aleatorios; credencial Bearer de POST /api/payments/worker (sin ella el endpoint responde 401). El worker además exige FIXO_PAYMENTS_NOTIFICATIONS_ENABLED=true
# FIXO_TRUSTED_IP_HEADER=x-vercel-forwarded-for  # cabecera que el proxy sobrescribe; sin ella todos los callbacks comparten un cubo estricto (nunca se confía en X-Forwarded-For del cliente)
# FLOW_API_KEY=
# FLOW_SECRET_KEY=
# FIXO_FLOW_CALLBACK_ORIGIN=https://<origen-https-autorizado>
# FIXO_PAYMENTS_SUPABASE_ORIGIN=https://<proyecto-aislado-autorizado>.supabase.co   # debe coincidir exactamente con NEXT_PUBLIC_SUPABASE_URL
# FIXO_PAYMENT_TOKEN_KEY_ID=
# FIXO_PAYMENT_TOKEN_KEY=   # 32 bytes en base64 (AES-256-GCM); sólo servidor
